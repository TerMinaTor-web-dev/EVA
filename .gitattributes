# Auto-detect text files and normalize line endings to LF on commit
* text=auto

# Source code
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.pro text eol=lf
*.properties text eol=lf

# Gradle wrappers
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary files
*.jar binary
*.keystore binary
*.webp binary
*.png binary
*.apk binary
*.aab binary
