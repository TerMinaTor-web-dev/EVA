<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Orbital Ring -->
    <path
        android:pathData="M54,20 C72.78,20 88,35.22 88,54 C88,72.78 72.78,88 54,88 C35.22,88 20,72.78 20,54 C20,35.22 35.22,20 54,20 Z"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.4"
        android:strokeColor="#00E5FF" />

    <!-- Tilted Gyro Ring -->
    <path
        android:pathData="M24,44 C34,28 74,28 84,44 C94,60 54,80 24,64"
        android:strokeWidth="2.0"
        android:strokeAlpha="0.7">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="24"
                android:startY="28"
                android:endX="84"
                android:endY="64"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#A855F7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Crystal Orb Glow Sphere -->
    <path android:pathData="M54,54m-24,0a24,24 0 1,0 48,0a24,24 0 1,0 -48,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="48"
                android:centerY="46"
                android:gradientRadius="26"
                android:type="radial">
                <item android:color="#8000E5FF" android:offset="0.0" />
                <item android:color="#55A855F7" android:offset="0.5" />
                <item android:color="#1A0A0C16" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular Crescent Lens Highlight -->
    <path
        android:pathData="M38,36 C44,32 64,32 70,36 C64,40 44,40 38,36 Z"
        android:fillColor="#80FFFFFF" />

    <!-- Central Diamond Core / Sparkle -->
    <path
        android:pathData="M54,38 L58,50 L70,54 L58,58 L54,70 L50,58 L38,54 L50,50 Z"
        android:fillColor="#FFFFFF" />

    <!-- Corner Star Sparkle -->
    <path
        android:pathData="M74,32 L76,38 L82,40 L76,42 L74,48 L72,42 L66,40 L72,38 Z"
        android:fillColor="#00E5FF" />
